#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
CACHE_DIR="$ROOT_DIR/target/nextest-cache"
SCRIPT_PATH="scripts/nextest-cache"

if command -v sha256sum >/dev/null 2>&1; then
  HASH_TOOL=(sha256sum)
elif command -v shasum >/dev/null 2>&1; then
  HASH_TOOL=(shasum -a 256)
else
  echo "missing sha256 tool (expected sha256sum or shasum)" >&2
  exit 1
fi

hash_stream() {
  "${HASH_TOOL[@]}" | awk '{print $1}'
}

hash_file() {
  "${HASH_TOOL[@]}" "$1" | awk '{print $1}'
}

usage() {
  cat <<'EOF'
Usage:
  ./scripts/nextest-cache [cargo nextest run args...]
  ./scripts/nextest-cache clean

Behavior:
  - wraps `cargo nextest run`
  - skips the run if the selected inputs and args match a previous successful run
  - stores cache metadata under target/nextest-cache

Options consumed by this wrapper:
  --no-cache    bypass the cache and force a real nextest run
EOF
}

if [[ "${1-}" == "-h" || "${1-}" == "--help" ]]; then
  usage
  exit 0
fi

if [[ "${1-}" == "clean" ]]; then
  rm -rf "$CACHE_DIR"
  echo "cleared $CACHE_DIR"
  exit 0
fi

SKIP_CACHE=0
declare -a NEXTTEST_ARGS=()
declare -a EXPLICIT_TESTS=()
INCLUDE_ALL_TESTS=1
LIB_ONLY=0

while (($#)); do
  arg="$1"
  shift
  case "$arg" in
    --no-cache)
      SKIP_CACHE=1
      ;;
    --lib)
      LIB_ONLY=1
      INCLUDE_ALL_TESTS=0
      NEXTTEST_ARGS+=("$arg")
      ;;
    --test)
      INCLUDE_ALL_TESTS=0
      NEXTTEST_ARGS+=("$arg")
      if (($# == 0)); then
        echo "--test requires a value" >&2
        exit 2
      fi
      EXPLICIT_TESTS+=("$1")
      NEXTTEST_ARGS+=("$1")
      shift
      ;;
    *)
      NEXTTEST_ARGS+=("$arg")
      ;;
  esac
done

declare -a INPUT_PATHS=(
  "Cargo.toml"
  "Cargo.lock"
  "agentpack.toml"
  "AGENTS.md"
  "$SCRIPT_PATH"
  "src"
  "runtime/queries"
)

for optional_path in build.rs .codesight.toml .cargo/config.toml .config/nextest.toml scripts/time-uncached-suite; do
  if [[ -e "$ROOT_DIR/$optional_path" ]]; then
    INPUT_PATHS+=("$optional_path")
  fi
done

if (( ! LIB_ONLY )); then
  if (( ${#EXPLICIT_TESTS[@]} > 0 )); then
    for test_name in "${EXPLICIT_TESTS[@]}"; do
      if [[ -f "$ROOT_DIR/tests/$test_name.rs" ]]; then
        INPUT_PATHS+=("tests/$test_name.rs")
      else
        INCLUDE_ALL_TESTS=1
      fi
    done
  fi

  if (( INCLUDE_ALL_TESTS )); then
    INPUT_PATHS+=("tests")
  fi

  if [[ -d "$ROOT_DIR/tests/fixtures" ]]; then
    INPUT_PATHS+=("tests/fixtures")
  fi
fi

gather_files() {
  local rel_path
  for rel_path in "${INPUT_PATHS[@]}"; do
    if [[ -f "$ROOT_DIR/$rel_path" ]]; then
      printf '%s\n' "$rel_path"
    elif [[ -d "$ROOT_DIR/$rel_path" ]]; then
      find "$ROOT_DIR/$rel_path" -type f | sed "s#^$ROOT_DIR/##"
    fi
  done | LC_ALL=C sort -u
}

inputs_hash="$(
  gather_files | while IFS= read -r rel_file; do
    printf '%s  %s\n' "$(hash_file "$ROOT_DIR/$rel_file")" "$rel_file"
  done | hash_stream
)"

args_hash="$(
  {
    cargo nextest --version 2>/dev/null || true
    rustc -Vv 2>/dev/null || rustc -V
    printf 'ARGS\0'
    printf '%s\0' "${NEXTTEST_ARGS[@]}"
  } | hash_stream
)"

stamp_dir="$CACHE_DIR/$args_hash"
stamp_path="$stamp_dir/$inputs_hash.ok"

mkdir -p "$stamp_dir"

if (( ! SKIP_CACHE )) && [[ -f "$stamp_path" ]]; then
  echo "nextest cache hit: unchanged inputs for cargo nextest run ${NEXTTEST_ARGS[*]}"
  cat "$stamp_path"
  exit 0
fi

(
  cd "$ROOT_DIR"
  cargo nextest run "${NEXTTEST_ARGS[@]}"
)

cat >"$stamp_path" <<EOF
timestamp=$(date -u +"%Y-%m-%dT%H:%M:%SZ")
args_hash=$args_hash
inputs_hash=$inputs_hash
command=cargo nextest run ${NEXTTEST_ARGS[*]}
EOF
