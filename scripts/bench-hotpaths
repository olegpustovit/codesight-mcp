#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
BIN="$ROOT/target/release/symslice-mcp"

if [[ ! -x "$BIN" ]]; then
  echo "Building release binary..."
  cargo build --release --manifest-path "$ROOT/Cargo.toml" 2>&1 | tail -1
fi

export SYMSLICE_INDEX_DIR
SYMSLICE_INDEX_DIR=$(mktemp -d)
trap 'rm -rf "$SYMSLICE_INDEX_DIR"' EXIT

ts() { python3 -c "import time; print(time.monotonic())"; }

echo "=== Cold full ingest (target: < 5 s) ==="
T0=$(ts)
INGEST_JSON=$("$BIN" ingest "$ROOT" --domains code 2>/dev/null)
T1=$(ts)
ELAPSED=$(python3 -c "print(f'{$T1 - $T0:.3f}s')")
echo "$INGEST_JSON" | python3 -c "
import sys, json
d = json.load(sys.stdin)
print(f'  files={d[\"data\"][\"file_count\"]}  symbols={d[\"data\"][\"symbol_count\"]}')
"
echo "  elapsed: $ELAPSED"
echo

SID=$(echo "$INGEST_JSON" | python3 -c "import sys,json; print(json.load(sys.stdin)['data']['source_id'])")
echo "source_id: $SID"
echo

echo "=== Keyword search ==="
T0=$(ts)
SEARCH_JSON=$("$BIN" search "$SID" "IndexStore" --domain code 2>/dev/null)
T1=$(ts)
ELAPSED=$(python3 -c "print(f'{$T1 - $T0:.3f}s')")
echo "$SEARCH_JSON" | python3 -c "
import sys, json
d = json.load(sys.stdin)
print(f'  items={len(d[\"data\"][\"items\"])}  timing={d[\"_meta\"][\"timing_ms\"]:.1f}ms')
"
echo "  elapsed: $ELAPSED"
echo

echo "=== Delta reindex after touch (target: < 100 ms) ==="
touch "$ROOT/src/lib.rs"
T0=$(ts)
DELTA_JSON=$("$BIN" ingest "$ROOT" --domains code 2>/dev/null)
T1=$(ts)
ELAPSED=$(python3 -c "print(f'{$T1 - $T0:.3f}s')")
echo "$DELTA_JSON" | python3 -c "
import sys, json
d = json.load(sys.stdin)
print(f'  files={d[\"data\"][\"file_count\"]}  symbols={d[\"data\"][\"symbol_count\"]}')
"
echo "  elapsed: $ELAPSED"
echo

# ── E9: incremental delete + rename scenarios ────────────────────────────
FIXTURE_ROOT=$(mktemp -d)
trap 'rm -rf "$SYMSLICE_INDEX_DIR" "$FIXTURE_ROOT"' EXIT
mkdir -p "$FIXTURE_ROOT/src"
cat >"$FIXTURE_ROOT/src/a.py" <<'PY'
def foo():
    return 1
PY
cat >"$FIXTURE_ROOT/src/b.py" <<'PY'
def bar():
    return 2
PY

"$BIN" ingest "$FIXTURE_ROOT" --domains code >/dev/null 2>&1

echo "=== Incremental delete ==="
rm "$FIXTURE_ROOT/src/b.py"
T0=$(ts)
DEL_JSON=$("$BIN" ingest "$FIXTURE_ROOT" --domains code 2>/dev/null)
T1=$(ts)
ELAPSED=$(python3 -c "print(f'{$T1 - $T0:.3f}s')")
echo "$DEL_JSON" | python3 -c "
import sys, json
d = json.load(sys.stdin)
delta = d['data'].get('delta', {})
print(f'  files_removed={delta.get(\"files_removed\", \"?\")}')
"
echo "  elapsed: $ELAPSED"
echo

echo "=== Incremental rename ==="
mv "$FIXTURE_ROOT/src/a.py" "$FIXTURE_ROOT/src/a_renamed.py"
T0=$(ts)
REN_JSON=$("$BIN" ingest "$FIXTURE_ROOT" --domains code 2>/dev/null)
T1=$(ts)
ELAPSED=$(python3 -c "print(f'{$T1 - $T0:.3f}s')")
echo "$REN_JSON" | python3 -c "
import sys, json
d = json.load(sys.stdin)
delta = d['data'].get('delta', {})
print(f'  files_reindexed={delta.get(\"files_reindexed\", \"?\")}  files_removed={delta.get(\"files_removed\", \"?\")}')
"
echo "  elapsed: $ELAPSED"
